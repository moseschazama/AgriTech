{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "reverb:start": "php artisan reverb:start",
        "queue:work": "php artisan queue:work --tries=3 --timeout=60",
        "start": "concurrently \"php artisan serve\" \"php artisan queue:work --tries=3 --timeout=60\" \"php artisan reverb:start\" \"npm run dev\"",
        "start:prod": "concurrently \"php artisan reverb:start --port=8080\" \"php artisan queue:work --tries=3 --timeout=60 --sleep=3\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "laravel-echo": "^2.4.0",
        "pusher-js": "^8.5.0"
    }
}
